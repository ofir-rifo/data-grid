{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        ".github/scripts/*.mjs",
        "tools/engineering/*.mjs",
        "eslint.config.mjs",
        "stylelint.config.mjs",
        "vitest.config.mts"
      ],
      "project": [".github/scripts/**/*.mjs", "tools/**/*.mjs", "*.{mjs,mts}"]
    },
    "apps/playground": {
      "entry": [
        "src/main.tsx",
        "src/**/*.spec.{ts,tsx}",
        "e2e/**/*.spec.ts",
        "*.config.{mts,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx,scss}", "e2e/**/*.ts", "*.config.{mts,mjs}"]
    }
  }
}
