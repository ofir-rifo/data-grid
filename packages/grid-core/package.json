{
  "name": "@org/grid-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "nx": {
    "tags": [
      "scope:grid",
      "type:core"
    ],
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vitest run --config packages/grid-core/vitest.config.mts --maxWorkers=1 --no-file-parallelism"
        }
      }
    }
  }
}
